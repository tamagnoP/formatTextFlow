<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Adjust Font Levels by Layer</name>
    <id>my.custom.unique.font.adjuster.2026</id>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Text"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">adjust_layers.py</command>
    </script>
</inkscape-extension>
